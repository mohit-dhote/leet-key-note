/* Write your PL/SQL query statement below */
with Sub_Compare as(
select 
	driver_id,trip_date, distance_km/fuel_consumed AS fuel_efficiency,CASE WHEN  EXTRACT(MONTH FROM trip_date)/*POSTGRESQL=>> DATE_PART('month',trip_date); MSSQL:=>> MONTH(trip_date)*/ between 1 and 6 THEN 'First_half' ELSE 'Second_half' END AS First_Second
from 
	trips
),Sub_AVG as(
select
	S1.driver_id, AVG(S1.fuel_efficiency) first_half_avg, AVG(S1.fuel_efficiency) second_half_avg, S1.First_Second
from 
	Sub_Compare S1
group by S1.driver_id,S1.First_Second
)
select
	A1.driver_id,D.driver_name, CAST(A1.first_half_avg AS decimal(10,2)) first_half_avg, CAST(A2.second_half_avg AS decimal(10,2)) second_half_avg, CAST(A2.second_half_avg - A1.first_half_avg AS decimal(10,2)) AS  efficiency_improvement 
from 
	Sub_AVG A1
	LEFT JOIN 
	(select * from Sub_AVG where First_Second = 'Second_half') A2 on A1.driver_id = A2.driver_id
	LEFT JOIN
	drivers D on A1.driver_id = D.driver_id
where 
	A1.First_Second = 'First_half'
and 
	A2.driver_id IS NOT NULL
and 
	A2.second_half_avg - A1.first_half_avg > 0
ORDER BY efficiency_improvement DESC, driver_name ASC

